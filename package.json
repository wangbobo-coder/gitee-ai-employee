{
  "name": "gitee-ai-employee",
  "version": "1.1.1",
  "description": "Gitee/GitHub AI 员工：在 issue 里 @ 机器人，它自动克隆仓库、按你指定的分支开发并提交 PR（可自动合并、自动关闭 issue）。An issue-driven AI developer for DeepSeek Harness (Gitee & GitHub): @ the bot on an issue, it clones the repo, implements on the branch you name, opens a PR, and can auto-merge and close.",
  "license": "MIT",
  "type": "module",
  "main": "dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./dsh": "./dsh/index.js",
    "./client": "./dsh/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./preset/gitee-worker/*": "./preset/gitee-worker/*"
  },
  "files": [
    "dsh",
    "preset",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "gitee",
    "plugin",
    "bundle",
    "ai",
    "issue",
    "pull-request",
    "automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangbobo-coder/gitee-ai-employee.git"
  },
  "homepage": "https://github.com/wangbobo-coder/gitee-ai-employee#readme",
  "bugs": {
    "url": "https://github.com/wangbobo-coder/gitee-ai-employee/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
